      "id": "13b9b5c7-8687-45d1-b799-fc6a2ab06c93",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "// This code takes the text extracted from a PDF and structures it into a clean JSON object.\n// It identifies numbered sections and the FAQ section to create a more usable format.\n\nconst items = $('Extract from File').all();\nconst structuredItems = [];\n\nfor (const item of items) {\n  // Get the raw text from the input item\n  const rawText = item.json.text;\n  if (!rawText) {\n    continue;\n  }\n\n  const structuredData = {};\n\n  // --- 1. Separate the main content from the FAQs ---\n  // We split the document at the FAQ title to handle them differently.\n  const faqSplit = rawText.split('\\nFrequently Asked Questions (FAQs)\\n');\n  const mainContent = faqSplit[0];\n  const faqContent = faqSplit.length > 1 ? faqSplit[1] : '';\n\n  // --- 2. Process the main, numbered sections ---\n  // This regex splits the text right before a new section starts (e.g., before \"\\n2. Hours of Operation\")\n  const sections = mainContent.split(/(?=\\n\\d+\\.\\s)/).map(s => s.trim());\n\n  // Handle the document title and header separately\n  const headerBlock = sections.shift() || '';\n  const headerLines = headerBlock.split('\\n');\n  structuredData.documentTitle = headerLines.shift(); // E.g., \"Customer Support Charter & Policies\"\n  structuredData.documentInfo = headerLines.map(line => line.trim()); // E.g., Version, Last Updated\n\n  // Loop through the numbered sections and create key-value pairs\n  for (const section of sections) {\n    const lines = section.split('\\n');\n    // The first line is the title, like \"2. Hours of Operation\"\n    const title = lines.shift().replace(/^\\d+\\.\\s*/, '').trim();\n    // The rest is the content\n    const content = lines.join('\\n').trim();\n    \n    // Use a cleaned-up title as the key in our new JSON object\n    if (title) {\n      structuredData[title] = content;\n    }\n  }\n\n  // --- 3. Process the FAQ section ---\n  if (faqContent) {\n    structuredData.FAQs = [];\n    // Split each question block, which starts with \"Q:\"\n    const questionBlocks = faqContent.split(/(?=Q:)/).filter(q => q.trim());\n    \n    for (const block of questionBlocks) {\n      // Separate the question from the answer\n      const qaParts = block.split('A:');\n      if (qaParts.length === 2) {\n        const question = qaParts[0].replace('Q:', '').trim();\n        const answer = qaParts[1].trim();\n        structuredData.FAQs.push({ question, answer });\n      }\n    }\n  }\n\n  // Add the newly structured JSON to the output\n  structuredItems.push({\n    json: structuredData,\n    pairedItem: item.pairedItem,\n  });\n}\n\n// Return the final array of structured items\nreturn structuredItems;"
      },
